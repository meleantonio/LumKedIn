# All optional. With nothing set, the app uses TF-IDF + templates (fully offline).
OPENAI_API_KEY=
# OpenAI-compatible endpoint (e.g. xAI: https://api.x.ai/v1)
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
# Optional Supabase pgvector mirror (see README for table SQL)
SUPABASE_URL=
SUPABASE_KEY=
KYM_DB=kym.sqlite

# Cognee memory backend (optional): pip install -r requirements-cognee.txt
KYM_BACKEND=tfidf          # or: cognee
LLM_API_KEY=
# For OpenAI-compatible endpoints (e.g. xAI), see Cognee docs:
# LLM_PROVIDER=openai
# LLM_MODEL=
# LLM_ENDPOINT=
# EMBEDDING_PROVIDER / EMBEDDING_MODEL / EMBEDDING_API_KEY may also be needed
